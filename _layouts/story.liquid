---
layout: swiss
---
{%- comment -%}
  Reader layout for one story in _stories/ (applied via _config.yml defaults).
  Chapter headings carry ids (#ch-1 ...) from bin/import_story.py; the table
  of contents is built from them.
{%- endcomment -%}
{%- assign chars = content | strip_html | size -%}
{%- assign mins = chars | divided_by: 3000.0 | round | times: 5 | at_least: 5 -%}
{%- assign parts = content | split: '<h2 id="' -%}
{%- assign chapter_count = parts | size | minus: 1 -%}

<div class="read-progress" aria-hidden="true"><span></span></div>

<div class="ex-crumb g mono">
  <div class="l"><a href="{{ '/' | relative_url }}">Index</a> / <a href="{{ '/stories/' | relative_url }}">Stories</a> / {{ page.num }}</div>
  <div class="r">
    <span>Short story · {{ page.year }}</span>
    <span>~{{ mins }} min</span>
  </div>
</div>

<header class="story-head g">
  <div class="ex-no" aria-hidden="true">{{ page.num }}</div>
  <div class="story-title-wrap">
    <div class="ex-short mono">
      <span class="tag">{{ page.year }}</span>
      <span class="dim">Written by Yeong Hwan Oh · Edited with Claude</span>
    </div>
    <h1 class="story-title" lang="ko">{{ page.title }}</h1>
    {%- if page.subtitle %}
      <p class="story-sub" lang="ko">{{ page.subtitle }}</p>
    {%- endif %}
  </div>
</header>

<div class="story-wrap g">
  {%- if chapter_count > 0 %}
    <nav class="story-toc" aria-label="Chapters">
      <details data-open-wide>
        <summary class="mono">Contents · {{ chapter_count }}</summary>
        <ol lang="ko">
          {%- for part in parts offset: 1 %}
            {%- assign hid = part | split: '"' | first -%}
            {%- assign htext = part | split: '</h2>' | first | split: '">' | last %}
            <li>
              <a href="#{{ hid }}">{{ htext }}</a>
            </li>
          {%- endfor %}
        </ol>
      </details>
    </nav>
  {%- endif %}
  <article class="story-body" lang="ko">
    {{ content }}
  </article>
</div>

<div class="story-end g">
  <div class="story-end-in mono">
    <span>End · {{ page.title }}</span>
    <span>Written by Yeong Hwan Oh · Edited with Claude</span>
  </div>
</div>

<nav class="ex-nav g mono" aria-label="Other stories">
  <div class="prev">
    {%- if page.previous %}
      <a href="{{ page.previous.url | relative_url }}">
        ← {{ page.previous.num -}}
        <span class="t" lang="ko">{{ page.previous.title }}</span>
      </a>
    {%- endif %}
  </div>
  <div class="idx">
    <a href="{{ '/stories/' | relative_url }}">All stories<span class="t">Stories</span></a>
  </div>
  <div class="next">
    {%- if page.next %}
      <a href="{{ page.next.url | relative_url }}">
        {{ page.next.num }} →<span class="t" lang="ko">{{ page.next.title }}</span>
      </a>
    {%- endif %}
  </div>
</nav>
