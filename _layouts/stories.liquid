---
layout: swiss
---
{%- comment -%}
  Stories index (/stories/). Not linked from the home page; reached from the
  header nav. Each story lives in _stories/ (see bin/import_story.py). Under
  each title the list quotes one key sentence from the story (`line`, Korean);
  the English `description` is used on the story page.
{%- endcomment -%}
{%- assign stories = site.stories | sort: 'date' | reverse -%}

<section class="ph">
  <div class="ph-top g mono">
    <span class="l"><span class="sect">§</span> Stories</span>
    <span class="r">{{ stories | size }} stories / In Korean</span>
  </div>
  <div class="g">
    <h1 class="ph-title">Stories</h1>
    <p class="ph-lede">Short stories I write for fun, in Korean, polished with an LLM.</p>
  </div>
</section>

<section class="sec" aria-label="Stories">
  <div class="st-list">
    {%- for s in stories %}
      <a class="st-row g" href="{{ s.url | relative_url }}">
        <span class="st-no">{{ s.num }}</span>
        <span class="st-main">
          <span class="st-title">{{ s.title }}</span>
          {%- if s.line %}
            <span class="st-desc st-line" lang="ko">“{{ s.line }}”</span>
          {%- else %}
            <span class="st-desc">{{ s.description }}</span>
          {%- endif %}
        </span>
        <span class="st-year mono">{{ s.year }}</span>
        <span class="st-go mono">Read →</span>
      </a>
    {%- endfor %}
  </div>
</section>
